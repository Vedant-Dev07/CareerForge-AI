			"problemMatcher": []
		},
		{
			"label": "Read running Node commands",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -in @(5024,6968) } | ForEach-Object { \"PID $($_.ProcessId): $($_.CommandLine)\" }",
